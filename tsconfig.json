{
	"compilerOptions": {
		"baseUrl": "./",
		"target": "ESNext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"outDir": "dist",
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"allowJs": true,
		"paths": {
			"@/*": [
				"./*"
			],
			"GreyScriptDefinitions": [
				"GreyScriptDefinitions.d.ts"
			]
		},
	},
	"include": ["src", "GreyScriptDefinitions.d.ts"]
}